# secrets — never commit
.env
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/

# sqlite sidecars (leads.db itself IS committed)
db/*.db-wal
db/*.db-shm

# ingest working files (raw downloads, unzipped CSVs)
data/
*.zip

# dashboard build outputs — regenerated by dashboard/build_static.py from db/leads.db
dashboard/leads.db
dashboard/preview.html
