# secrets — never commit
.env
*.key

# python
__pycache__/
*.py[cod]
.venv/
venv/

# sqlite sidecars (leads.db itself IS committed)
db/*.db-wal
db/*.db-shm

# ingest working files (raw downloads, unzipped CSVs)
data/
*.zip

# preview.html is a 5 MB build output; dashboard/leads.db IS committed so the
# published page fetches the pruned copy instead of the full db/leads.db.
dashboard/preview.html
